{
    "configurations": [
        {
            "name": "PrioRTOS RV32",
            "compilerPath": "/usr/bin/riscv64-unknown-elf-gcc",
            "compilerArgs": [
                "-march=rv32i_zicsr",
                "-mabi=ilp32",
                "-mcmodel=medany",
